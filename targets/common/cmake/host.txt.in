cmake_minimum_required(VERSION 3.20)
project(@NAME@_@SYSTEM@_host C)
set(CMAKE_C_STANDARD 11)
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()
set(SRC ${CMAKE_CURRENT_SOURCE_DIR}/../src)
add_executable(@NAME@_host @SOURCES@)
target_include_directories(@NAME@_host PRIVATE ${SRC})
target_compile_definitions(@NAME@_host PRIVATE SG_GENERATED=1)
target_compile_options(@NAME@_host PRIVATE -Wall -Wextra)
