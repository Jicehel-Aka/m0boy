cmake_minimum_required(VERSION 3.20)
project(@NAME@_@SYSTEM@_firmware C CXX ASM)
set(CMAKE_C_STANDARD 11)
set(CMAKE_CXX_STANDARD 11)
if(NOT CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Use -DCMAKE_TOOLCHAIN_FILE=arm-toolchain.cmake for firmware, or build host/ for the native harness")
endif()
set(SRC ${CMAKE_CURRENT_SOURCE_DIR}/src)
# Pokitto platform files, plus for the Game Gear what it streams from the
# card (the streamed ROM, its FAT reader and the shared SD bus).
file(GLOB PLATFORM_C ${SRC}/pokitto_*.c@PLATFORM_EXTRA@)
add_executable(firmware @SOURCES@ ${PLATFORM_C})
target_include_directories(firmware PRIVATE ${SRC})
# Extra compile definitions of the day (e.g. -DPOKITTO_HC=1): C, C++ and the
# preprocessed assembly, without touching the toolchain's flags.
set(EXTRA_DEFS "" CACHE STRING "extra compile definitions")
# Firmware compiler: gcc, or clang through toolchain/arm_clang.py (C/C++
# only; assembly, the linker script and the link stay with the GNU tools).
set(SG_COMPILER "@COMPILER@" CACHE STRING "Firmware C/C++ compiler: gcc or clang")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(SG_COMPILER STREQUAL "clang")
    set(SG_WRAPPER ${CMAKE_CURRENT_SOURCE_DIR}/toolchain/arm_clang.py)
    set_target_properties(firmware PROPERTIES
        C_COMPILER_LAUNCHER "${Python3_EXECUTABLE};${SG_WRAPPER};--launcher;--language;c;--"
        CXX_COMPILER_LAUNCHER "${Python3_EXECUTABLE};${SG_WRAPPER};--launcher;--language;c++;--")
elseif(NOT SG_COMPILER STREQUAL "gcc")
    message(FATAL_ERROR "SG_COMPILER must be gcc or clang")
endif()
target_compile_options(firmware PRIVATE -O2 -ffunction-sections -fdata-sections -fno-common -Wall
    ${EXTRA_DEFS}
    $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions> $<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>)
add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/pokitto.ld
    COMMAND ${CMAKE_C_COMPILER} -E -P -x c -I${SRC} ${CMAKE_CURRENT_SOURCE_DIR}/pokitto.ld -o ${CMAKE_CURRENT_BINARY_DIR}/pokitto.ld
    DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/pokitto.ld ${SRC}/gbl_profile.h ${SRC}/gbl_board.h)
add_custom_target(linker_script DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/pokitto.ld)
add_dependencies(firmware linker_script)
target_link_options(firmware PRIVATE -nostartfiles --specs=nano.specs --specs=nosys.specs
    -Wl,--gc-sections -Wl,-Map=${CMAKE_CURRENT_BINARY_DIR}/firmware.map -T${CMAKE_CURRENT_BINARY_DIR}/pokitto.ld)
set_target_properties(firmware PROPERTIES SUFFIX ".elf" LINK_DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/pokitto.ld)
get_filename_component(SG_ARM_BIN "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(OBJCOPY arm-none-eabi-objcopy HINTS "${SG_ARM_BIN}" REQUIRED)
add_custom_command(TARGET firmware POST_BUILD
    COMMAND ${OBJCOPY} -O binary $<TARGET_FILE:firmware> ${CMAKE_CURRENT_BINARY_DIR}/firmware.bin
    COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/checksum.py ${CMAKE_CURRENT_BINARY_DIR}/firmware.bin)
