; Generated by gbrecomp --target meta for @NAME@.
; Build:  pio run          Upload over USB:  pio run -t upload
; Or copy .pio/build/meta/firmware.bin to the META SD card as @NAME@.bin.
[platformio]
boards_dir = boards

[env:meta]
platform = atmelsam
board = gamebuino_meta
framework = arduino
board_build.ldscript = gamebuino_meta.ld
; The Arduino Zero variant without the unused hardware UART objects.
board_build.variants_dir = variants
board_build.variant = gbl_meta
build_unflags = -Os
build_flags = -O2 -Wno-unused-label
