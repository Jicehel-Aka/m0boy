"""Flash the ROM image with the firmware (same esptool command), when the ROM
is larger than what the application holds."""
Import("env")
from pathlib import Path

# Register before the platform constructs esptool's upload command.
rom = Path(env.subst("$PROJECT_DIR")) / "rom.bin"
if rom.exists():
    env.Append(FLASH_EXTRA_IMAGES=[("0x100000", str(rom))])
