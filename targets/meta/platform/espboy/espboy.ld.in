/* ESP8266, 4 MiB: the application is all the CPU maps (ESPBOY_APP_BYTES);
 * rom.bin follows at 0x100000, saves at 0x3C0000, and the SDK's EEPROM/RF/
 * Wi-Fi sectors at 0x3FB000.  Arduino ESP8266 eagle.flash.4m.ld (3.1.2). */
MEMORY
{
  dport0_0_seg : org = 0x3FF00000, len = 0x10
  dram0_0_seg : org = 0x3FFE8000, len = 0x14000
  irom0_0_seg : org = 0x40201010, len = 0xfeff0
}
PROVIDE ( _FS_start = 0x405FB000 );
PROVIDE ( _FS_end = 0x405FB000 );
PROVIDE ( _FS_page = 0 );
PROVIDE ( _FS_block = 0 );
PROVIDE ( _EEPROM_start = 0x405FB000 );
PROVIDE ( _SPIFFS_start = 0x405FB000 );
PROVIDE ( _SPIFFS_end = 0x405FB000 );
PROVIDE ( _SPIFFS_page = 0 );
PROVIDE ( _SPIFFS_block = 0 );
INCLUDE "local.eagle.app.v6.common.ld"
