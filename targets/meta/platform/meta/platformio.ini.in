; Generated by gbrecomp --target meta for @NAME@.
; Build:  pio run          Upload over USB:  pio run -t upload
; Or copy .pio/build/meta/firmware.bin to the META SD card as @NAME@.bin.
[platformio]
boards_dir = boards

[env:meta]
platform = atmelsam
board = gamebuino_meta
custom_compiler = @COMPILER@
extra_scripts = post:toolchain/platformio_compiler.py
; Bare metal (meta_startup.c, meta_spi.c): no framework, only the SAMD21
; CMSIS headers.
platform_packages =
    platformio/framework-cmsis@~1.40500.0
    platformio/framework-cmsis-atmel@~1.2.2
board_build.ldscript = gamebuino_meta.ld
build_unflags = -Os -DUSBCON
build_flags = -O2 -Wno-unused-label
    -I${platformio.packages_dir}/framework-cmsis/CMSIS/Include
    -I${platformio.packages_dir}/framework-cmsis-atmel/CMSIS/Device/ATMEL
