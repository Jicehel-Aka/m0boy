# Run before project(): compiler choices become fixed in the build cache.
function(m0boy_select_host_compiler)
    option(M0BOY_PREFER_CLANG "Prefer Clang for native CMake builds when available" ON)
    if(DEFINED CMAKE_TOOLCHAIN_FILE OR DEFINED ENV{CMAKE_TOOLCHAIN_FILE}
       OR DEFINED CMAKE_SYSTEM_NAME)
        return()
    endif()
    foreach(language IN LISTS ARGN)
        if(language STREQUAL "C")
            set(env_name CC)
        else()
            set(env_name CXX)
        endif()
        if(DEFINED CMAKE_${language}_COMPILER
           OR (DEFINED ENV{${env_name}} AND NOT "$ENV{${env_name}}" STREQUAL ""))
            return()
        endif()
    endforeach()

    set(families gcc)
    if(M0BOY_PREFER_CLANG)
        list(PREPEND families clang)
    endif()
    foreach(family IN LISTS families)
        set(complete TRUE)
        foreach(language IN LISTS ARGN)
            if(language STREQUAL "C")
                set(name ${family})
            elseif(family STREQUAL "clang")
                set(name clang++)
            else()
                set(name g++)
            endif()
            find_program(_M0BOY_${family}_${language} NAMES ${name})
            mark_as_advanced(_M0BOY_${family}_${language})
            if(NOT _M0BOY_${family}_${language})
                set(complete FALSE)
            endif()
        endforeach()
        if(complete)
            foreach(language IN LISTS ARGN)
                set(CMAKE_${language}_COMPILER "${_M0BOY_${family}_${language}}"
                    CACHE FILEPATH "${language} compiler")
            endforeach()
            return()
        endif()
    endforeach()
    # Other native platforms may provide neither pair (e.g. MSVC).
    # Leave those to CMake's platform defaults.
endfunction()
