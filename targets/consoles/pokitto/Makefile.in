# Generated by gbrecomp --target pokitto for @NAME@.
#
#   make            build/firmware.bin (boot checksum included) and a size report
#   make clean
#
# Copy build/firmware.bin to the Pokitto SD card as @NAME@.bin (the loader
# lists .bin files) with the game's other files next to it.  Bare metal: no
# mbed, no PokittoLib; only arm-none-eabi-gcc (newlib-nano).  The compiler is
# taken from PATH, else from PlatformIO's toolchain-gccarmnoneeabi package
# (the one the META builds use); override with TOOLCHAIN=<dir>/.

TOOLCHAIN ?= $(if $(shell command -v arm-none-eabi-gcc 2>/dev/null),,$(HOME)/.platformio/packages/toolchain-gccarmnoneeabi/bin/)
CC := $(TOOLCHAIN)arm-none-eabi-gcc
CXX := $(TOOLCHAIN)arm-none-eabi-g++
OBJCOPY := $(TOOLCHAIN)arm-none-eabi-objcopy
SIZE := $(TOOLCHAIN)arm-none-eabi-size
PYTHON ?= python3

COMPILER ?= $(if $(FIRMWARE_COMPILER),$(FIRMWARE_COMPILER),@COMPILER@)
ASCC := $(CC)
LINK := $(CXX)
ifeq ($(COMPILER),clang)
CC := $(PYTHON) toolchain/arm_clang.py --gcc $(TOOLCHAIN)arm-none-eabi-gcc --language c --
CXX := $(PYTHON) toolchain/arm_clang.py --gcc $(TOOLCHAIN)arm-none-eabi-gcc --language c++ --
else ifneq ($(COMPILER),gcc)
$(error COMPILER must be gcc or clang)
endif

# Separate directories prevent mixing GCC and Clang objects when switching.
BUILD := $(if $(filter clang,$(COMPILER)),build-clang,build)
ARCH := -mcpu=cortex-m0plus -mthumb
COMMON := $(ARCH) -O2 -g -ffunction-sections -fdata-sections -fno-common \
          -Wall -Wno-unused-label -Isrc $(EXTRA_CFLAGS)
COMPILER_DEPS := $(if $(filter clang,$(COMPILER)),toolchain/arm_clang.py,)
CFLAGS := $(COMMON) -std=gnu11
CXXFLAGS := $(COMMON) -std=gnu++11 -fno-exceptions -fno-rtti -fno-threadsafe-statics
ASFLAGS := $(ARCH) -g -Isrc -x assembler-with-cpp $(EXTRA_CFLAGS)
LDFLAGS := $(ARCH) -nostartfiles --specs=nano.specs --specs=nosys.specs \
           -Wl,--gc-sections -Wl,-Map=$(BUILD)/firmware.map -T $(BUILD)/pokitto.ld

SRC_C := $(wildcard src/*.c)
SRC_CXX := $(wildcard src/*.cpp)
SRC_S := $(wildcard src/*.S)
OBJ := $(SRC_C:src/%.c=$(BUILD)/%.o) $(SRC_CXX:src/%.cpp=$(BUILD)/%.o) $(SRC_S:src/%.S=$(BUILD)/%.o)
DEP := $(OBJ:.o=.d)

all: $(BUILD)/firmware.bin

$(BUILD)/%.o: src/%.c $(COMPILER_DEPS) | $(BUILD)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
$(BUILD)/%.o: src/%.cpp $(COMPILER_DEPS) | $(BUILD)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@
$(BUILD)/%.o: src/%.S | $(BUILD)
	$(ASCC) $(ASFLAGS) -MMD -MP -c $< -o $@

# The linker script sees the profile (POKITTO_RAM_BANKS): preprocessed.
$(BUILD)/pokitto.ld: pokitto.ld src/gbl_config.h src/gbl_profile.h src/gbl_board.h | $(BUILD)
	$(CC) -E -P -x c -Isrc $(EXTRA_CFLAGS) $< -o $@

$(BUILD)/firmware.elf: $(OBJ) $(BUILD)/pokitto.ld
	$(LINK) $(LDFLAGS) $(OBJ) -o $@

# The LPC boot ROM runs user code only when the first eight vector words
# sum to zero: word 7 takes the two's complement of the others.
$(BUILD)/firmware.bin: $(BUILD)/firmware.elf
	$(OBJCOPY) -O binary $< $@
	$(PYTHON) -c "import struct,sys; p=sys.argv[1]; b=bytearray(open(p,'rb').read()); w=struct.unpack_from('<7I',b,0); struct.pack_into('<I',b,28,(-sum(w))&0xffffffff); open(p,'wb').write(b)" $@
	@$(SIZE) $<
	@$(PYTHON) -c "import os,sys; n=os.path.getsize(sys.argv[1]); print('flash: %d / %d bytes (%.1f%%) below the loader at 0x39000' % (n, 0x39000, 100.0*n/0x39000))" $@

$(BUILD):
	mkdir -p $(BUILD)

clean:
	rm -rf $(BUILD)

.PHONY: all clean
-include $(DEP)
