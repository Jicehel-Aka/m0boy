# Gamebuino AKA (8 MiB flash): the application in the official 3000K slot, the raw ROM
# image beside it (rom.bin at 0x380000) when the generator writes one.
nvs,      data, nvs,     0x9000,   0x5000
otadata,  data, ota,     0xe000,   0x2000
app0,     app,  ota_0,   0x10000,  0x2EE000
rom,      data, 0x01,    0x380000, 0x300000
