; ODROID-GO (ESP32-WROVER, 16 MiB flash): application and ROM in a 4 MiB
; partition area, saves on the microSD card.
[env:odroid]
platform = espressif32@6.9.0
board = odroid_esp32
framework = arduino
board_build.f_cpu = 240000000L
board_upload.flash_size = 16MB
board_build.partitions = odroid.csv
build_flags = -Os -Wno-unused-label
    -DBOARD_HAS_PSRAM
    -DCORE_DEBUG_LEVEL=0
    -DCONFIG_ARDUINO_LOOP_STACK_SIZE=32768
build_src_filter = +<*> -<*.S> -<m0_menu_scratch*>
extra_scripts = pre:odroid_build.py
    post:odroid_size.py
