# Builds and conversions stay local: no ROMs or firmwares in the repository.
# /build covers the symlink case too (a local build/ -> output/build-gcc).
/build
/build/
/out/
/output/
/logs/
/roms/*
!/roms/gb/
/roms/gb/*
!/roms/gb/README.txt
/profiles/*
!/profiles/.gitkeep
*.gb
*.gbc
*.bin
*.elf
node_modules/
*.sg

!/roms/sg/
/roms/sg/*
!/roms/sg/README.txt
__pycache__/
